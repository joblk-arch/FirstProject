# Local AI Operations Dashboard - Environment Configuration
# Copy to .env and fill in real values. Never commit real secrets.

# Agent gateway (server-side only; never exposed to the browser)
AGENT_GATEWAY_URL=http://host.docker.internal:8765
AGENT_GATEWAY_KEY_FILE=/run/secrets/agent_gateway_key
AGENT_GATEWAY_ALLOWED_PROJECTS=firstproject

# Dashboard authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_FILE=/run/secrets/dashboard_password
DASHBOARD_USERS_FILE=/run/secrets/dashboard_users

# Audit logging
DASHBOARD_AUDIT_LOG_FILE=/tmp/local-ai-dashboard-audit.jsonl

# Templates
DASHBOARD_TEMPLATES_FILE=/data/templates.json
